VITE_BASE_PATH=
# Required for deployed static frontend builds. Leave blank locally to use the
# Vite proxy at http://127.0.0.1:8000; never hardcode localhost in production.
VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://takasafe-diu.surge.sh
# FastAPI uses port 8000 by default. This is only used by legacy static preview.
PORT=3000
GEMINI_API_KEY=
BKASH_CREATE_PAYMENT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/create
BKASH_AUTH_TOKEN=
BKASH_APP_KEY=
BKASH_CALLBACK_URL=
REDIS_STREAM_REST_URL=
REDIS_STREAM_REST_TOKEN=
REDIS_STREAM_KEY=takasafe:transactions
