VITE_BASE_PATH=
# Required for deployed static frontend builds. Leave blank locally to use the
# Vite proxy at http://127.0.0.1:8000; never hardcode localhost in production.
VITE_API_BASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://takasafe-diu.surge.sh
# Local development uses HTTP; enable HTTPS enforcement in production behind TLS.
REQUIRE_HTTPS=false
# Set true only when HTTPS is terminated by a trusted reverse proxy. Restrict
# FORWARDED_ALLOW_IPS to that proxy's addresses in the deployment environment.
TRUST_PROXY_HEADERS=false
FORWARDED_ALLOW_IPS=127.0.0.1
# Generate a URL-safe base64 key from 32 random bytes and keep it in a secret manager.
PII_ENCRYPTION_KEY=
# FastAPI uses port 8000 by default. The Node gateway serves the bKash sandbox
# endpoint and WebSocket stream during local development.
PORT=3000
GATEWAY_PORT=3002
GEMINI_API_KEY=
BKASH_CREATE_PAYMENT_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized/checkout/create
BKASH_AUTH_TOKEN=
BKASH_APP_KEY=
BKASH_CALLBACK_URL=
REDIS_STREAM_REST_URL=
REDIS_STREAM_REST_TOKEN=
REDIS_STREAM_KEY=takasafe:transactions
