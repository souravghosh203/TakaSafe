{
  "model_name": "TakaSafe_ScamShield_XGBoost",
  "version": "1.0.0",
  "description": "Real-time pre-payment MFS fraud and scam classification model",
  "framework": "xgboost",
  "model_file": "scamshield_xgb.json",
  "optimal_threshold": 0.45,
  "risk_bands": {
    "LOW": [0, 30],
    "MEDIUM": [31, 60],
    "HIGH": [61, 80],
    "CRITICAL": [81, 100]
  },
  "feature_order": [
    "amount",
    "amount_deviation_ratio",
    "is_new_recipient",
    "transaction_hour",
    "is_nocturnal",
    "transaction_frequency",
    "behavior_deviation_score",
    "recipient_incoming_surge",
    "is_mule_cluster_linked",
    "device_change_flag",
    "location_mismatch_flag"
  ],
  "feature_defaults": {
    "amount": 1000.0,
    "amount_deviation_ratio": 1.0,
    "is_new_recipient": 0,
    "transaction_hour": 12,
    "is_nocturnal": 0,
    "transaction_frequency": 1,
    "behavior_deviation_score": 0.05,
    "recipient_incoming_surge": 0,
    "is_mule_cluster_linked": 0,
    "device_change_flag": 0,
    "location_mismatch_flag": 0
  },
  "feature_weights_explainability": {
    "is_new_recipient": 0.32,
    "amount_deviation_ratio": 0.27,
    "is_nocturnal": 0.19,
    "is_mule_cluster_linked": 0.16,
    "recipient_incoming_surge": 0.14,
    "device_change_flag": 0.12,
    "location_mismatch_flag": 0.08
  }
}
